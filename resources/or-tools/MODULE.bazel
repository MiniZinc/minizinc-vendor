bazel_dep(name = "rules_pkg", version = "1.2.0")

# or-tools pins rules_go 0.53, whose .bzl files use the `CcInfo` global that Bazel 9
# removed; 0.59 is the first release that loads it from rules_cc. We build no Go, but
# or-tools registers the Go toolchains, so they have to load for toolchain resolution.
single_version_override(
    module_name = "rules_go",
    version = "0.59.0",
)
