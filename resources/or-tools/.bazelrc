# Prefer static C++ linking where possible.
build --dynamic_mode=off

# Enable automatic platform-specific config sections (build:windows, build:linux, build:macos).
common --enable_platform_specific_config

# Bazel 9 removed the built-in rule and provider globals and emptied the autoload list,
# but or-tools pins BCR modules that predate that (bzip2's BUILD calls a bare cc_binary,
# rules_go 0.53 uses a bare CcInfo). This is Bazel 8's default list plus +@rules_cc, which
# restores Bazel 8 semantics; drop it once or-tools' dependency set is Bazel 9 clean.
common --incompatible_autoload_externally=+@rules_cc,+@rules_python,+@rules_android,+java_common,+JavaInfo,+JavaPluginInfo,ProguardSpecProvider,java_binary,java_import,java_library,java_plugin,java_test,java_runtime,java_toolchain,java_package_configuration,@com_google_protobuf,@rules_shell

# Build optimized binaries by default.
build -c opt

# Use C++20 across platforms.
build:windows --cxxopt=/std:c++20
build:linux --cxxopt=-std=c++20
build:macos --cxxopt=-std=c++20

# Match the deployment target of the other solvers (bazel ignores
# MACOSX_DEPLOYMENT_TARGET). or-tools' own .bazelrc asks for 10.15; this file is
# read after it, so the later -mmacos-version-min is the one clang honours.
build:macos --macos_minimum_os=12.0 --cxxopt=-mmacos-version-min=12.0
